APP_NAME=GreenLine ETA API
APP_ENV=development
API_V1_PREFIX=/api/v1
#DATABASE_URL=postgresql+asyncpg://greenline:greenline@localhost:5432/greenline
DATABASE_URL=sqlite+aiosqlite:///./greenline.db
# Clé navigateur dédiée, restreinte par référent HTTP et à Maps JavaScript API.
# Chemin du JSON de compte de service Google pour Routes API (ignoré par Git).
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GOOGLE_MAPS_API_KEY=
# Clé serveur dédiée à Geocoding API (ne pas exposer dans le navigateur).
GOOGLE_GEOCODING_API_KEY=
# Clé serveur dédiée à Maps Static API (pour générer les images d’itinéraire).
GOOGLE_STATIC_MAPS_API_KEY=
# URL publique de l’API, utile derrière un proxy (ex. https://api.example.com).
PUBLIC_API_BASE_URL=
HIBOO_API_BASE_URL=https://api.hiboo.io
HIBOO_API_NAME=
HIBOO_API_KEY=
# Secret d’administration de l’interface de gestion des tokens GreenLine.
API_ADMIN_TOKEN=
# Quota journalier par défaut pour les routes API protégées (UTC).
API_DAILY_LIMIT_DEFAULT=1000
