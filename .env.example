APP_NAME=GreenLine ETA API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/greenline
# Clé navigateur dédiée, restreinte par référent HTTP et à Maps JavaScript API.
